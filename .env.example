# Database. Tests and the zero-setup default use SQLite. Anything involving
# pgvector or MLflow needs the Postgres from `make db-up` — uncomment that line.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://wavepoint:wavepoint@localhost:5433/wavepoint

# Frontend CORS (deploy only; dev uses the Vite /api proxy). A bare origin, a
# comma-separated list, or a JSON list — all three parse:
#   CORS_ALLOW_ORIGINS=https://wavepoint-web.onrender.com
#   CORS_ALLOW_ORIGINS=https://a.example.com,https://b.example.com
#   CORS_ALLOW_ORIGINS='["https://wavepoint-web.onrender.com"]'
# render.yaml leaves this sync: false — the static site's URL is not known
# until it first deploys, so it is typed into the dashboard by hand. The bare
# form is legal precisely because that is what a human types into a text box.
CORS_ALLOW_ORIGINS=

# Upload limits
MAX_UPLOAD_BYTES=52428800
MAX_ROWS=1000000

# Profiler tunables (design §4)
PROFILE_MAX_CARDINALITY=20
PROFILE_MAX_CORR_COLS=30
PROFILE_TOP_CORR_PAIRS=25
PROFILE_SAMPLE_ROWS=5
PROFILE_TOKEN_BUDGET=8000

# Anthropic (required for /chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# MLflow (design D4). Shares the app Postgres in the `mlflow` schema.
# Leave empty when running on SQLite — training endpoints will refuse to run.
MLFLOW_TRACKING_URI=
# MLFLOW_TRACKING_URI=postgresql://wavepoint:wavepoint@localhost:5433/wavepoint?options=-csearch_path%3Dmlflow
MLFLOW_ARTIFACT_ROOT=./mlruns

# MLflow artifact store (D48). Empty locally — artifacts stay on local disk at
# MLFLOW_ARTIFACT_ROOT above. On Render, set MLFLOW_ARTIFACT_ROOT to an s3:// URI
# and fill all three of these; see "Artifact storage" in README.md.
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Training (design §3.3). A column with more distinct values than this is treated
# as an identifier rather than a category, and dropped from inferred features.
FEATURE_MAX_CARDINALITY=20

# Optuna (design §3.8). Studies run synchronously inside the request, so these
# bound how long one /experiments/tune call can hold a connection open.
OPTUNA_MAX_TRIALS=50
OPTUNA_STUDY_TIMEOUT_S=600

# LLM loop (issue #9)
LLM_MAX_PASSES=3
LLM_QUALITY_THRESHOLD=80
# JUDGE_MODEL="" reuses ANTHROPIC_MODEL for the judge call
JUDGE_MODEL=

# OpenTelemetry (3.1). Off by default; `make db-up` already runs Jaeger.
# Traces at http://localhost:16686 once OTEL_ENABLED=true.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Voyage embeddings (D14). Needed by `make embed`, and later by the agent's
# search, which embeds every query. Never set in CI — tests mock the provider.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Retry for Voyage rate limits. The free tier allows 3 requests/minute and
# `make embed` sends one request per changed source, so a review session of a
# dozen notes trips it routinely; only 429s are retried.
VOYAGE_MAX_ATTEMPTS=4
VOYAGE_RETRY_BASE_SECONDS=2.0

# Chunk budget in characters (D29). Changing this invalidates the whole index:
# re-run `make embed` after any change.
CHUNK_MAX_CHARS=1000

# The agent's tool loop (3.5). AGENT_MAX_K caps the sources one search_runs call
# may return — each one's snippet lands in the model's context.
AGENT_MAX_TURNS=6
AGENT_MAX_K=25
AGENT_MAX_LEADERBOARD_ROWS=20
